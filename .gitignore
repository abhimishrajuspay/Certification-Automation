# Secrets and local configuration
.env
.env.*

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build and packaging output
*.egg-info/
build/
dist/

# Runtime evidence and logs
artifacts/
logs/
*.log

# Local tooling state (branch context stays private, harness assets are tracked)
!.opencode/
.opencode/*
!.opencode/agents/**/*.md
!.opencode/commands/**/*.md
!.opencode/skills/**/*.md
!.opencode/skills/**/*.py
!.opencode/skills/**/*.sh
!.opencode/skills/**/*.json
!.opencode/skills/**/*.example

# Recoverable legacy archive; intentionally local-only
.deprecated/

# Local point-in-time backups; never publish crawl evidence or session material
.backups/

# User-provided dummy portal; intentionally outside crawler source and tests
dummy-portal/
dummy_portal/

# User-provided local MCP server clone + database/env assets (contains credentials)
mcp/

# OpenCode harness assets tracked; branch context stays local
!.opencode/agents/
!.opencode/commands/
!.opencode/skills/
.opencode/context/current-branch.md
.opencode/context/branches/*.md
.opencode/context/subagents/
.opencode/context/task-board.md
.opencode/context/repo-knowledge.json
.opencode/context/repo-knowledge.json.lock
.opencode/index/
.opencode/tasks/*/out/
.opencode/tasks/*/worktrees/
.opencode/logs/

# Local certification inputs and generated validation state
/out/
/.pre-commit-config.yaml
/APISpecs_*
/*.csv
/*.xlsx
/*.postman_collection.json
/clStore.cache
/*.rdb

# One-off machine-specific replay harness; not part of the generic skill
/.opencode/skills/certification-automation/scripts/run_all.sh

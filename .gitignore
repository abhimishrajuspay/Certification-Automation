# Secrets and local configuration
.env
.env.*

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build and packaging output
*.egg-info/
build/
dist/

# Runtime evidence and logs
artifacts/
logs/

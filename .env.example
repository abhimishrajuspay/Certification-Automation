# CZ Certification Automation - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# CZ Portal Configuration
# ============================================
CZ_BASE_URL=https://portal.example.com/TestCases/List2
# JSESSIONID cookie value (leave empty to be prompted at runtime)
JSESSIONID=

# ============================================
# Repository Context
# ============================================
# Absolute path to the application repository
REPO_PATH=/path/to/your/application/repo
# Comma-separated list of subdirectories within REPO_PATH to scan for context
ALLOWED_CONTEXT_PATHS=schemas/,fixtures/,templates/

# ============================================
# LiteLLM Configuration
# ============================================
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL=gpt-4o
LITELLM_API_KEY=your-api-key-here

# ============================================
# Kubernetes Configuration
# ============================================
K8S_POD=my-pod
K8S_NAMESPACE=my-namespace
K8S_LOCAL_PORT=8080
K8S_REMOTE_PORT=8080
K8S_HEALTH_CHECK_ENDPOINT=http://localhost:8080/health

# ============================================
# Execution Configuration
# ============================================
# Delay in milliseconds between actions to avoid rate limiting
RATE_LIMIT_DELAY_MS=1000
# Maximum retries for LLM self-correction
MAX_LLM_RETRIES=3
# Maximum timeout for a single test case execution (seconds)
MAX_TC_EXECUTION_TIMEOUT_SEC=60
# Enable parallel execution (default: sequential)
PARALLEL=false
MAX_PARALLEL_WORKERS=4
# Enable human review guardrail
HUMAN_REVIEW=false

# ============================================
# Output Configuration
# ============================================
ARTIFACTS_DIR=./artifacts
SCREENSHOTS_DIR=./artifacts/screenshots
LOGS_DIR=./artifacts/logs
